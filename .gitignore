# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv*/
.pytest_cache/
.ipynb_checkpoints/

# ---- Environments / IDE ----
.idea/
.idea_old/
.vscode/

# ---- Secrets (never commit) ----
id_rsa*
*.pem
*_rsa
*_rsa.pub

# ---- Large model / vector blobs (see data/README.md for provenance + how to obtain) ----
*.vec
*.bin
*.pk
*.pkl
*.pickle
model.txt
cc.*.vec
ukrdict-*
*-embeddings
*-simvecs
*-with-vitz-nonce

# ---- Fonts ----
*.ttf
*.ttc
*.otf

# ---- Generated pipeline artifacts (regenerated by `nguasach run ...`) ----
data/interim/
data/processed/
results/
figures/
runs/
legacy_results/
*.done
run_manifest*.json

# ---- Vendored third-party checkouts ----
third_party/**/__pycache__/

# ---- OS cruft ----
.DS_Store
Thumbs.db
~$*
*.tmp

# old 2.1GB history, safe to delete once you are comfortable
.git_disabled_DELETE_ME/
